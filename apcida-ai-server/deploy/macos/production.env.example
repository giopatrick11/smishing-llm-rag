# Copy to a private location outside Git only after a dedicated database exists.
# This file is a template. Never put real keys in the repository.
APCIDA_PRODUCTION_ENABLED=true
APCIDA_PRODUCTION_MODE=controlled-test
APCIDA_PRODUCTION_BIND=127.0.0.1
APCIDA_PRODUCTION_PORT=3021

# Dedicated local PostgreSQL cluster, separate from the development and temporary pilot databases.
DATABASE_URL=postgresql://127.0.0.1:55436/apcida
PRODUCTION_DATA_KEY=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS

OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:12b
RAG_ENABLED=true
RULES_ENABLED=true
RULES_SHADOW_MODE=true
VERDICT_POLICY=gemma
REQUEST_TIMEOUT_MS=90000

# Set retention only after the privacy and backup policy is approved.
# APCIDA_PRODUCTION_RETENTION_HOURS=24
# APCIDA_PRODUCTION_IDENTITY_RETENTION_DAYS=30
